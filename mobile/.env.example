# API URL: omit EXPO_PUBLIC_API_BASE_URL to auto-pick (simulator → localhost, iPhone → Render).
# Override only when needed:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1
#   EXPO_PUBLIC_API_BASE_URL=https://portfolio-dashboard-agent.onrender.com/api/v1
#
# npm scripts:
#   npm run ios:local     → force localhost (simulator)
#   npm run start:render  → force Render (any device)

# Must match MOBILE_DEV_TOKEN on the API only for legacy single-user dev bypass.
# Prefer Google Sign-In (below) when the API has OAuth enabled on Render.
# EXPO_PUBLIC_MOBILE_DEV_TOKEN=pda-local-mobile-dev

# Google Sign-In — iOS OAuth client ID (Google Cloud Console, bundle com.portfolio.dashboard).
# Required when the API has authEnabled=true (GOOGLE_OAUTH_* on Render).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: Web OAuth client ID (Expo Go / dev). Often the same as GOOGLE_OAUTH_CLIENT_ID on the API.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_SHOW_API_HOST=1
